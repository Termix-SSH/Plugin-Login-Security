{
  "id": "login-security",
  "name": "Login Security",
  "version": "1.1.0",
  "description": "Sign people out when idle, limit session length, turn off remember me and require a second factor at login.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Login-Security",
  "docs": "https://docs.termix.site/plugins/login-security",
  "video": "https://www.youtube.com/watch?v=Vjmm9lucls4",
  "category": "Access & Security",
  "icon": "ShieldCheck",
  "features": [
    "Sign out after a set time without activity, in the browser and on the server",
    "Limit how long a session can last",
    "Turn off remember me and remembered devices",
    "Require a second factor at every login or on a new device",
    "Works with any installed second factor, like an authenticator app or a security key",
    "People without a second factor are asked to set one up before they can use Termix",
    "Ask for a second factor before connecting to a host, for every host or only marked ones"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.16"
  },
  "capabilities": [
    "auth:policy",
    "hosts:connect-policy",
    "hosts:read",
    "network:serve",
    "ui:surface"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "connect-verify",
        "titleKey": "verify.title",
        "icon": "ShieldCheck",
        "openFrom": ["palette"]
      }
    ],
    "permissions": [
      {
        "name": "manage",
        "titleKey": "permissions.manage.title",
        "descriptionKey": "permissions.manage.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "idleTimeoutMinutes",
          "type": "number",
          "group": "settings.group.sessions",
          "labelKey": "settings.admin.idleTimeoutMinutes.label",
          "descriptionKey": "settings.admin.idleTimeoutMinutes.description",
          "default": 0,
          "min": 0,
          "max": 1440
        },
        {
          "key": "maxSessionHours",
          "type": "number",
          "group": "settings.group.sessions",
          "labelKey": "settings.admin.maxSessionHours.label",
          "descriptionKey": "settings.admin.maxSessionHours.description",
          "default": 0,
          "min": 0,
          "max": 720
        },
        {
          "key": "rememberDevice",
          "type": "boolean",
          "group": "settings.group.sessions",
          "labelKey": "settings.admin.rememberDevice.label",
          "descriptionKey": "settings.admin.rememberDevice.description",
          "default": true
        },
        {
          "key": "secondFactor",
          "type": "select",
          "group": "settings.group.secondFactor",
          "labelKey": "settings.admin.secondFactor.label",
          "descriptionKey": "settings.admin.secondFactor.description",
          "default": "off",
          "options": [
            { "value": "off", "labelKey": "settings.admin.secondFactor.off" },
            {
              "value": "new-device",
              "labelKey": "settings.admin.secondFactor.newDevice"
            },
            {
              "value": "always",
              "labelKey": "settings.admin.secondFactor.always"
            }
          ]
        },
        {
          "key": "applyToExternal",
          "type": "boolean",
          "group": "settings.group.secondFactor",
          "labelKey": "settings.admin.applyToExternal.label",
          "descriptionKey": "settings.admin.applyToExternal.description",
          "default": false
        },
        {
          "key": "factors",
          "type": "custom",
          "group": "settings.group.secondFactor",
          "component": "factors"
        },
        {
          "key": "connectFactor",
          "type": "select",
          "group": "settings.group.connect",
          "labelKey": "settings.admin.connectFactor.label",
          "descriptionKey": "settings.admin.connectFactor.description",
          "default": "off",
          "options": [
            { "value": "off", "labelKey": "settings.admin.connectFactor.off" },
            {
              "value": "marked",
              "labelKey": "settings.admin.connectFactor.marked"
            },
            { "value": "all", "labelKey": "settings.admin.connectFactor.all" }
          ]
        },
        {
          "key": "connectFactorMinutes",
          "type": "number",
          "group": "settings.group.connect",
          "labelKey": "settings.admin.connectFactorMinutes.label",
          "descriptionKey": "settings.admin.connectFactorMinutes.description",
          "default": 60,
          "min": 1,
          "max": 1440
        }
      ],
      "host": {
        "editorGroup": "top",
        "editorOrder": 95,
        "enableKey": "requireConnectFactor",
        "enableLabelKey": "settings.host.requireConnectFactor.label",
        "enableDescriptionKey": "settings.host.requireConnectFactor.description",
        "fields": []
      }
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "desktop": "server"
}
