{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [],
  "routes": {
    "POST /plugin-api/login-security/activity": {
      "access": "user"
    },
    "GET /plugin-api/login-security/policy": {
      "access": "user"
    },
    "GET /plugin-api/login-security/status": {
      "access": "user",
      "permission": "login-security.manage"
    }
  }
}
